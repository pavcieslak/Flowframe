{
  "manifestVersion": 5,
  "id": "pl.lucmedia.flowframe",
  "name": "Flowframe",
  "version": "1.2.1",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "flowframePanel",
      "label": {
        "default": "Flowframe"
      },
      "minimumSize": {
        "width": 230,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 270,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 270,
        "height": 560
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ],
          "species": [
            "chrome"
          ]
        }
      ]
    },
    {
      "type": "command",
      "id": "ffAdd",
      "label": {
        "default": "Add auto layout"
      }
    },
    {
      "type": "command",
      "id": "ffRemove",
      "label": {
        "default": "Remove auto layout"
      }
    },
    {
      "type": "command",
      "id": "ffReflow",
      "label": {
        "default": "Reflow selected auto layout"
      }
    },
    {
      "type": "command",
      "id": "ffReflowAll",
      "label": {
        "default": "Reflow all on this spread"
      }
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {}
}